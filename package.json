{
  "name": "signal-loom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "engine": "cargo run -p loom-serve -- --port 43128",
    "dev:preview": "concurrently -k -n engine,ui -c yellow,cyan \"npm:engine\" \"npm:dev\"",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
